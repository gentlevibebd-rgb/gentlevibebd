'use client';

import { useState, useEffect, useRef } from 'react';
import Image from 'next/image';
import { db } from '@/lib/firebase';
import { collection, onSnapshot, query, orderBy, addDoc, serverTimestamp } from 'firebase/firestore';

const heroSlides = [
  { src: '/8798746a8d4ad68sd.webp', alt: "Gentle Vibe BD Premium Men's Fashion" },
  { src: '/gentlevibebdbanner.webp', alt: 'Gentle Vibe BD Collection 2' },
  { src: '/gentlevibebdbanner2.webp', alt: 'Gentle Vibe BD Collection 3' },
];

const catItems = [
  { href: '/products?cat=tshirt', img: '/b8d4bf080617a6536be73b00684b8e9e.webp', alt: 'T-Shirts', label: 'T-Shirts' },
  { href: '/products?cat=shirt', img: '/aaaaaaa.webp', alt: 'Shirts', label: 'Shirts' },
  { href: '/products?cat=pant', img: '/528cc35a8158fb408677f43dd56e478c.webp', alt: 'Pants', label: 'Pants' },
  { href: '/products?cat=watch', img: '/67469874567465.webp', alt: 'Watches', label: 'Watches' },
  { href: '/products?cat=combo', img: '/56we4rf3as5d1651ewr.webp', alt: 'Combo Deals', label: 'Combo Deals' },
  { href: '/products?cat=wallet', img: '/51501adde946d8d907f15c0ae52d7f22.webp', alt: 'Wallets', label: 'Wallets' },
];

const catCards = [
  { href: '/products?cat=tshirt', img: '/weraw65drfa6s54df.webp', alt: 'T-Shirts', label: 'T-Shirts' },
  { href: '/products?cat=shirt', img: '/54erf6adsf2.webp', alt: 'Shirts', label: 'Shirts' },
  { href: '/products?cat=pant', img: '/64d6a4d.webp', alt: 'Pants', label: 'Pants' },
  { href: '/products?cat=watch', img: '/67469874567465.webp', alt: 'Luxury Watches', label: 'Luxury Watches' },
  { href: '/products?cat=wallet', img: '/51501adde946d8d907f15c0ae52d7f22.webp', alt: 'Wallets', label: 'Wallets' },
  { href: '/products?cat=combo', img: '/56we4rf3as5d1651ewr.webp', alt: 'Combo Deals', label: 'Combo Deals' },
];

const fallbackProducts = [
  { id: '1', name: "Men's Elegant Black & White Stripe Shirt", price: 499, originalPrice: 750, rating: 5, reviews: 124, images: ["/54erf6adsf2.webp"] },
  { id: '2', name: "Premium Olive Green Corduroy Baggy Pant", price: 550, originalPrice: 890, rating: 5, reviews: 98, images: ["/64d6a4d.webp"] },
  { id: '4', name: "Luxury Poedagar Watch", price: 699, originalPrice: 1499, rating: 5, reviews: 112, images: ["/dasdfsaf54546.webp"] },
  { id: '5', name: "Premium Watch + Polo Combo", price: 899, originalPrice: 1599, rating: 5, reviews: 64, images: ["/4a4dsas56d4as5d4.webp"] },
  { id: '6', name: "Premium Stripe Shirt & Baggy Pant Combo", price: 950, originalPrice: 1350, rating: 4, reviews: 53, images: ["/56we4rf3as5d1651ewr.webp"] },
  { id: '7', name: "Classic Old money polo T-Shirt", price: 499, originalPrice: 799, rating: 5, reviews: 87, images: ["/weraw65drfa6s54df.webp"] },
  { id: '9', name: "Poedagar Luxury Watch", price: 699, originalPrice: 1499, rating: 5, reviews: 132, images: ["/67469874567465.webp"] }
];

function starRow(n) {
  let s = '';
  for (let i = 0; i < 5; i++) s += i < n ? '★' : '☆';
  return s;
}

export default function HomeClient({ products: initialProducts }) {
  const [liveProducts, setLiveProducts] = useState(initialProducts && initialProducts.length > 0 ? initialProducts : []);

  const [currentSlide, setCurrentSlide] = useState(0);
  const [menuOpen, setMenuOpen] = useState(false);
  const [scrolled, setScrolled] = useState(false);
  const [cartCount, setCartCount] = useState(0);
  const [wishlist, setWishlist] = useState(new Set());
  const [toast, setToast] = useState({ show: false, msg: '' });

  const [subEmail, setSubEmail] = useState('');
  const [subMsg, setSubMsg] = useState('');
  const [submitting, setSubmitting] = useState(false);

  const displayProducts = liveProducts.length > 0 ? liveProducts : fallbackProducts;

  const showToast = (msg) => {
    setToast({ show: true, msg });
    setTimeout(() => setToast({ show: false, msg: '' }), 2400);
  };

  const updateCartCount = () => {
    try {
      const cart = JSON.parse(localStorage.getItem('cart') || '[]');
      const count = cart.reduce((a, c) => a + (c.qty || 1), 0);
      setCartCount(count);
    } catch (e) {
      setCartCount(0);
    }
  };

  // Real-time Firestore Listener for Products
  useEffect(() => {
    updateCartCount();

    const handleScroll = () => setScrolled(window.scrollY > 30);
    window.addEventListener('scroll', handleScroll);

    // Live Real-Time listener on products collection
const unsubscribe = onSnapshot(
  query(collection(db, 'products'), orderBy('createdAt', 'desc')),
      (snap) => {
        const list = snap.docs
          .map((d) => ({ id: d.id, ...d.data() }))
          .filter((p) => p.active !== false);

        if (list.length > 0) {
          setLiveProducts(list.slice(0, 8));
        }
      },
      (err) => {
        console.error('Realtime Firestore Listener Error:', err);
      }
    );

    // Facebook Pixel Delay Pattern
    function loadPixel() {
      setTimeout(() => {
        (function (f, b, e, v, n, t, s) {
          if (f.fbq) return;
          n = f.fbq = function () {
            n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
          };
          if (!f._fbq) f._fbq = n;
          n.push = n; n.loaded = !0; n.version = "2.0"; n.queue = [];
          t = b.createElement(e); t.async = !0;
          t.src = v; s = b.getElementsByTagName(e)[0];
          s.parentNode.insertBefore(t, s);
        })(window, document, "script", "https://connect.facebook.net/en_US/fbevents.js");
        window.fbq("init", "4238792793034225");
        window.fbq("track", "PageView");
      }, 3000);
    }

    if (document.readyState === "complete") loadPixel();
    else {
      window.addEventListener("load", loadPixel);
    }

    return () => {
      window.removeEventListener('scroll', handleScroll);
      unsubscribe();
    };
  }, []);

  useEffect(() => {
    const timer = setInterval(() => {
      setCurrentSlide((prev) => (prev + 1) % heroSlides.length);
    }, 6500);
    return () => clearInterval(timer);
  }, []);

  useEffect(() => {
    const targets = document.querySelectorAll('.reveal-up, .product, .cat-card, .promo, .app-promo, .feat-strip');
    if (!targets.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry, idx) => {
          if (entry.isIntersecting) {
            setTimeout(() => {
              entry.target.classList.add('in-view', 'visible');
            }, idx * 30);
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.05, rootMargin: '0px 0px -20px 0px' }
    );

    targets.forEach((t) => observer.observe(t));
    return () => observer.disconnect();
  }, [displayProducts]);

  const addToCart = (p, e) => {
    e.stopPropagation();
    try {
      const cart = JSON.parse(localStorage.getItem('cart') || '[]');
      const existing = cart.find(c => c.id === p.id && !c.size);
      if (existing) {
        existing.qty = (existing.qty || 1) + 1;
      } else {
        cart.push({
          id: p.id,
          name: p.name,
          price: p.price,
          image: p.images?.[0] || p.img || '',
          qty: 1,
          size: null
        });
      }
      localStorage.setItem('cart', JSON.stringify(cart));
      updateCartCount();
      showToast(`${p.name} added to cart`);
    } catch (err) {
      console.error('Cart error:', err);
    }
  };

  const toggleWishlist = (id, e) => {
    e.stopPropagation();
    setWishlist((prev) => {
      const next = new Set(prev);
      if (next.has(id)) {
        next.delete(id);
        showToast('Removed from wishlist');
      } else {
        next.add(id);
        showToast('Added to wishlist ♥');
      }
      return next;
    });
  };

  const handleSubscribe = async (e) => {
    e.preventDefault();
    if (!subEmail || !subEmail.includes('@')) return;
    setSubmitting(true);
    setSubMsg('');

    try {
      await addDoc(collection(db, 'subscribers'), {
        email: subEmail.trim(),
        subscribedAt: serverTimestamp()
      });

      fetch('https://script.google.com/macros/s/AKfycbxKtfJQBVprDnVryQ-AvWifAQHGRyVRq8NmhqM8LET2eV0fb9orGzmemDeU0g98nT1x/exec', {
        method: 'POST',
        body: new URLSearchParams({ email: subEmail.trim() })
      }).catch(() => {});

      setSubMsg('Thanks for subscribing! Check your inbox for 10% off.');
      setSubEmail('');
      showToast('Subscribed! Check your email 🖤');
    } catch (err) {
      console.error('Newsletter error:', err);
      setSubMsg('Something went wrong. Please try again.');
    } finally {
      setSubmitting(false);
    }
  };

  return (
    <>
      {/* Toast Notification */}
      {toast.show && (
        <div className="toast show" id="toast">
          {toast.msg}
        </div>
      )}

      {/* ======== NAVBAR ======== */}
      <header className={`navbar ${scrolled ? 'scrolled' : ''}`} id="navbar">
        <a href="/" className="logo">
          <Image
            src="/545sd4fdsf54.webp"
            className="logo-img"
            alt="Gentle Vibe BD Logo"
            width={40}
            height={40}
            unoptimized
          />
          <span className="logo-name">Gentle Vibe <em>BD</em></span>
        </a>

        <nav className={`nav-links ${menuOpen ? 'open' : ''}`} id="navLinks">
          <a href="/" className="active" onClick={() => setMenuOpen(false)}>Home</a>
          <a href="/products" onClick={() => setMenuOpen(false)}>Shop</a>
          <a href="/checkout" onClick={() => setMenuOpen(false)}>Checkout</a>
          <a href="/about" onClick={() => setMenuOpen(false)}>About</a>
          <a href="/contact" onClick={() => setMenuOpen(false)}>Contact Us</a>
          <a href="/track" onClick={() => setMenuOpen(false)}>Track Order</a>
        </nav>

        <div className="nav-actions">
          <a className="cart-btn" id="cartBtn" href="/cart" aria-label="Cart">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8">
              <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
              <line x1="3" y1="6" x2="21" y2="6"/>
              <path d="M16 10a4 4 0 01-8 0"/>
            </svg>
            <span className="cart-count" id="cartCount">{cartCount}</span>
          </a>
          <button
            className={`menu-toggle ${menuOpen ? 'open' : ''}`}
            id="menuBtn"
            onClick={() => setMenuOpen(!menuOpen)}
            aria-label="Menu"
          >
            <span></span><span></span><span></span>
          </button>
        </div>
      </header>

      {/* ======== HERO ======== */}
      <section className="hero" id="shop">
        <div className="hero-bg" id="heroBg">
          {heroSlides.map((slide, i) => (
            <Image
              key={i}
              src={slide.src}
              alt={slide.alt}
              fill
              className={`hero-slide ${currentSlide === i ? 'active' : ''}`}
              priority={i === 0}
              unoptimized
              style={{ objectFit: 'cover' }}
            />
          ))}
        </div>
        <div className="hero-overlay"></div>

        <div className="hero-content reveal-in">
          <div className="eyebrow">— Men's Premium Style —</div>
          <h1>Elevate Your<br /><span>Style Game</span></h1>
          <p>Premium T-shirts, luxury watches &amp; exclusive combos. Bangladesh's finest destination for refined men's fashion.</p>
          <div className="hero-cta">
            <a className="btn-primary" id="shopNowBtn" href="/products">
              Shop Now
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
            <button
              className="btn-ghost"
              id="lookbookBtn"
              onClick={() => {
                const el = document.getElementById('bestsellers');
                if (el) el.scrollIntoView({ behavior: 'smooth' });
              }}
            >
              <span className="play-circle">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
              </span>
              Explore Collection
            </button>
          </div>

          <div className="hero-feats">
            <div className="hero-feat">
              <svg className="fi" viewBox="0 0 24 24" fill="none" strokeWidth="1.4"><path d="M2 8h13v8H2zM15 11h4l3 3v2h-7z"/><circle cx="6" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/></svg>
              <div><div className="t1">Free Delivery</div><div className="t2">On orders over ৳2000</div></div>
            </div>
            <div className="hero-feat">
              <svg className="fi" viewBox="0 0 24 24" fill="none" strokeWidth="1.4"><rect x="3" y="7" width="18" height="14" rx="1"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
              <div><div className="t1">Easy Returns</div><div className="t2">3-day hassle-free</div></div>
            </div>
            <div className="hero-feat">
              <svg className="fi" viewBox="0 0 24 24" fill="none" strokeWidth="1.4"><path d="M12 2 4 5v6c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10V5z"/></svg>
              <div><div className="t1">Secure Payment</div><div className="t2">100% protected</div></div>
            </div>
          </div>
        </div>

        <div className="hero-tabs" id="heroTabs">
          {heroSlides.map((_, i) => (
            <span
              key={i}
              className={currentSlide === i ? 'active' : ''}
              onClick={() => setCurrentSlide(i)}
            >
              {String(i + 1).padStart(2, '0')}
            </span>
          ))}
        </div>
      </section>

      {/* ======== CATEGORY QUICK STRIP ======== */}
      <div className="cat-strip" id="categories">
        {catItems.map((item, i) => (
          <a key={i} className={`cat-item ${i === 0 ? 'active' : ''}`} href={item.href}>
            <span className="cat-circle">
              <Image src={item.img} alt={item.alt} width={64} height={64} unoptimized loading="lazy" />
            </span>
            <span className="cat-label">{item.label}</span>
          </a>
        ))}
        <a className="cat-item sale" href="/products?cat=Sale">
          <span className="cat-circle">SALE</span>
          <span className="cat-label">Sale</span>
        </a>
      </div>

      {/* ======== SHOP BY CATEGORY ======== */}
      <section className="section">
        <div className="container">
          <div className="sec-head reveal-up">
            <div>
              <div className="eyebrow">Collections</div>
              <h2>Find Your<br />Perfect Fit</h2>
            </div>
            <a href="/products" className="view-all">
              View All Categories
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          </div>

          <div className="cat-grid">
            {catCards.map((card, i) => (
              <a key={i} className="ph cat-card reveal-up" href={card.href}>
                <Image src={card.img} alt={card.alt} fill unoptimized loading="lazy" style={{ objectFit: 'cover' }} />
                <div className="cap">
                  <h3>{card.label}</h3>
                  <span>Explore Now
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                  </span>
                </div>
              </a>
            ))}
          </div>

          <div className="promo-grid">
            <div className="promo a reveal-up">
              <Image src="/bannerimage1.webp" alt="Summer Sale" className="promo-bg-img" fill unoptimized loading="lazy" style={{ objectFit: 'cover' }} />
              <div className="promo-overlay"></div>
              <div className="promo-content">
                <div className="eyebrow">Limited Time Offer</div>
                <h3>Summer Sale<br />Up to 38% Off</h3>
                <a className="btn-primary" style={{ width: 'fit-content' }} href="/products?cat=tshirt">
                  Shop The Sale
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </a>
              </div>
            </div>

            <div className="promo b reveal-up">
              <Image src="/aaaaaaaaaaa.webp" alt="Combo Deals" className="promo-bg-img" fill unoptimized loading="lazy" style={{ objectFit: 'cover' }} />
              <div className="promo-overlay"></div>
              <div className="promo-content">
                <div className="eyebrow">New Arrivals</div>
                <h3>Fresh Combo Deals<br />Just Landed</h3>
                <a className="btn-primary" style={{ width: 'fit-content' }} id="exploreNewBtn" href="/products?cat=combo">
                  Explore New In
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* ======== BEST SELLERS ======== */}
      <section className="section" id="bestsellers">
        <div className="container">
          <div className="sec-head reveal-up">
            <div>
              <div className="eyebrow">Bestsellers</div>
              <h2>Trending Right Now</h2>
            </div>
          </div>

          <div className="product-grid" id="productGrid">
            {displayProducts.map((p) => {
              const origPrice = p.originalPrice || p.old || p.price + 1;
              const discount = origPrice > p.price ? Math.round(((origPrice - p.price) / origPrice) * 100) : 0;
              const mainImg = p.images?.[0] || p.img || '/favicon.png';

              return (
                <div
                  key={p.id}
                  className="product"
                  onClick={() => { window.location.href = `/details/${p.id}`; }}
                >
                  <div
                    className="product-img"
                    style={{ backgroundImage: `url('${mainImg}')`, backgroundSize: 'cover', backgroundPosition: 'center' }}
                  >
                    {discount > 0 && (
                      <span style={{ position: 'absolute', top: 12, left: 12, zIndex: 4, fontSize: 10, fontWeight: 700, padding: '5px 10px', borderRadius: 6, color: '#fff', background: '#c0392b', textTransform: 'uppercase' }}>
                        {discount}% OFF
                      </span>
                    )}
                    <button
                      className={`wishlist ${wishlist.has(p.id) ? 'active' : ''}`}
                      onClick={(e) => toggleWishlist(p.id, e)}
                      aria-label="Add to wishlist"
                    >
                      <svg viewBox="0 0 24 24"><path d="M12 21s-7-4.35-9.5-8.5C.5 8.5 3 5 6.5 5c2 0 3.5 1.2 4.5 2.5C12 6.2 13.5 5 15.5 5 19 5 21.5 8.5 19.5 12.5 17 16.65 12 21 12 21z" /></svg>
                    </button>
                  </div>
                  <div className="p-name">{p.name}</div>
                  <div className="p-price">
                    ৳{p.price}{' '}
                    {origPrice > p.price && (
                      <span style={{ color: 'var(--muted)', fontWeight: 500, textDecoration: 'line-through', fontSize: 12 }}>
                        ৳{origPrice}
                      </span>
                    )}
                  </div>
                  <div className="p-rating">
                    <span className="stars">{starRow(p.rating || 5)}</span> ({p.reviews || 0})
                  </div>
                  <button className="add-cart-mini" onClick={(e) => addToCart(p, e)}>
                    Add to Cart
                  </button>
                </div>
              );
            })}
          </div>
        </div>
      </section>

      {/* ======== VIEW ALL PRODUCTS CTA ======== */}
      <div className="view-all-cta reveal-up">
        <a href="/products" className="view-all-btn">
          View All Products
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>

      {/* ======== APP DOWNLOAD PROMO ======== */}
      <section className="section" style={{ paddingTop: 0 }}>
        <div className="container">
          <div className="app-promo reveal-up">
            <div className="app-promo-content">
              <div className="eyebrow">Gentle Vibe BD App</div>
              <h2>Shop Faster With<br />Our Mobile App</h2>
              <p>এক্সক্লুসিভ ডিল, দ্রুত চেকআউট আর ইজি অর্ডার ট্র্যাকিং — সব একদম হাতের মুঠোয়। এখনই আমাদের অ্যাপ ডাউনলোড করুন।</p>
              <a className="btn-primary app-download-btn" href="/GentleVibeBD.apk" download>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/></svg>
                Download APK
              </a>
              <div className="app-promo-meta">
                <span>📦 Size: 7.0MB</span>
                <span>⭐ Android 10.0+</span>
              </div>
            </div>
            <div className="app-promo-icon">
              <svg width="90" height="90" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.2">
                <rect x="5" y="2" width="14" height="20" rx="2"/>
                <line x1="12" y1="18" x2="12.01" y2="18"/>
              </svg>
            </div>
          </div>
        </div>
      </section>

      {/* ======== FEATURE STRIP ======== */}
      <section className="section" style={{ paddingTop: 0 }}>
        <div className="container">
          <div className="feat-strip reveal-up">
            <div className="hero-feat">
              <svg className="fi" viewBox="0 0 24 24" fill="none" strokeWidth="1.4"><path d="M2 8h13v8H2zM15 11h4l3 3v2h-7z"/><circle cx="6" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/></svg>
              <div><div className="t1">Free Delivery</div><div className="t2">On orders over ৳2000</div></div>
            </div>
            <div className="hero-feat">
              <svg className="fi" viewBox="0 0 24 24" fill="none" strokeWidth="1.4"><rect x="3" y="7" width="18" height="14" rx="1"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
              <div><div className="t1">Easy Returns</div><div className="t2">3-day hassle-free</div></div>
            </div>
            <div className="hero-feat">
              <svg className="fi" viewBox="0 0 24 24" fill="none" strokeWidth="1.4"><path d="M12 2 4 5v6c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10V5z"/></svg>
              <div><div className="t1">Secure Payment</div><div className="t2">100% protected</div></div>
            </div>
            <div className="hero-feat">
              <svg className="fi" viewBox="0 0 24 24" fill="none" strokeWidth="1.4"><path d="M4 4h4l1 2h11l-2 9H8"/><circle cx="9" cy="19" r="1.4"/><circle cx="17" cy="19" r="1.4"/></svg>
              <div><div className="t1">24/7 Support</div><div className="t2">Always here for you</div></div>
            </div>
          </div>
        </div>
      </section>

      {/* ======== NEWSLETTER ======== */}
      <section className="section" style={{ paddingTop: 0 }} id="newsletter">
        <div className="container">
          <div className="newsletter reveal-up">
            <div className="ph">
              <Image src="/gentlevibebdbanner.webp" alt="Gentle Vibe BD Collection" fill unoptimized loading="lazy" style={{ objectFit: 'cover' }} />
            </div>
            <div className="newsletter-content">
              <div className="eyebrow">Get 10% Off Your First Order</div>
              <h2>Join Our Exclusive List</h2>
              <p style={{ fontSize: 14, marginBottom: 22 }}>Sign up for early access to new arrivals and special deals. No spam, unsubscribe anytime.</p>
              <form className="sub-form" id="subForm" onSubmit={handleSubscribe}>
                <input
                  type="email"
                  placeholder="Enter your email"
                  required
                  id="subEmail"
                  value={subEmail}
                  onChange={(e) => setSubEmail(e.target.value)}
                />
                <button type="submit" disabled={submitting}>
                  {submitting ? 'Please wait...' : 'Subscribe'}
                </button>
              </form>
              <div className="form-msg" id="subMsg">{subMsg}</div>
            </div>
          </div>
        </div>
      </section>

